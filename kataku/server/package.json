{
  "name": "server",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:refresh": "rm -rf drizzle && bun src/db/reset.ts && bun run db:generate && bun run db:migrate && drizzle-kit up",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/opentelemetry": "^1.2.0",
    "@elysiajs/swagger": "^1.2.2",
    "better-auth": "^1.2.5",
    "drizzle-orm": "^0.41.0",
    "drizzle-seed": "^0.3.1",
    "elysia": "latest",
    "pg": "^8.14.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "bun-types": "latest",
    "drizzle-kit": "^0.30.6"
  },
  "module": "src/index.js"
}
