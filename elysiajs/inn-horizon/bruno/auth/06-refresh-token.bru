meta {
  name: 06 Refresh Token
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refresh_token}}"
  }
}

tests {
  test("should return 200 status", function() {
    expect(res.status).to.equal(200);
  });

  test("should return success true", function() {
    const data = res.body;
    expect(data.success).to.equal(true);
  });

  test("should return new tokens", function() {
    const data = res.body;
    expect(data.data).to.have.property('accessToken');
    expect(data.data).to.have.property('refreshToken');
  });

  test("should save new tokens to environment", function() {
    const data = res.body;
    if (data.success && data.data) {
      bru.setEnvVar('access_token', data.data.accessToken);
      bru.setEnvVar('refresh_token', data.data.refreshToken);
    }
  });
}

docs {
  # Refresh Access Token

  Get new access token using refresh token.

  ## Request Body
  - `refreshToken` (string, required): Valid refresh token

  ## Response
  Returns new token pair (access & refresh tokens).

  ## Use Case
  When access token expires (after 7 days), use this endpoint to get a new one without requiring user to login again.

  ## Notes
  - Refresh token is long-lived (30 days)
  - Both access and refresh tokens are refreshed
  - Old tokens become invalid after refresh

  ## Error Responses
  - 401: Invalid or expired refresh token
}
