meta {
  name: register - short password
  type: http
  seq: 7
}

post {
  url: {{host}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "testuser@example.com",
    "password": "123",
    "name": "Test User",
    "role": "CUSTOMER"
  }
}

tests {
  test("should return 400 or 422 status", function() {
    expect([400, 422]).to.include(res.status);
  });

  test("should return error message", function() {
    expect(res.body.error).to.exist;
  });
}
