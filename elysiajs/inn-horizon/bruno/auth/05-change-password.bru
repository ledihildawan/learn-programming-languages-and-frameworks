meta {
  name: 05 Change Password
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "currentPassword": "Test1234",
    "newPassword": "NewTest1234"
  }
}

tests {
  test("should return 200 status", function() {
    expect(res.status).to.equal(200);
  });

  test("should return success true", function() {
    const data = res.body;
    expect(data.success).to.equal(true);
  });

  test("should return success message", function() {
    const data = res.body;
    expect(data.message).to.include('successfully');
  });
}

docs {
  # Change Password

  Change authenticated user's password.

  ## Authentication
  Requires Bearer token in Authorization header.

  ## Request Body
  - `currentPassword` (string, required): Current password
  - `newPassword` (string, required): New password (min 8 characters, must contain letter and number)

  ## Validation
  - Current password must be correct
  - New password must be different from current password
  - New password must meet strength requirements

  ## Response
  Returns success message.

  ## Error Responses
  - 400: Invalid password or validation failed
  - 401: Missing or invalid token
}
