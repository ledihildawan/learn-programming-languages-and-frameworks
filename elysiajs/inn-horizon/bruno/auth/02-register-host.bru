meta {
  name: 02 Register Host
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "host@test.com",
    "password": "Host1234",
    "name": "Jane Host",
    "phone": "081234567891",
    "role": "HOST",
    "bankName": "Bank Mandiri",
    "bankCode": "008",
    "accountNumber": "1234567890",
    "accountName": "Jane Host"
  }
}

tests {
  test("should return 201 status", function() {
    expect(res.status).to.equal(201);
  });

  test("should return success true", function() {
    const data = res.body;
    expect(data.success).to.equal(true);
  });

  test("should return user with HOST role", function() {
    const data = res.body;
    expect(data.data.user).to.have.property('role');
    expect(data.data.user.role).to.equal('HOST');
  });

  test("should save tokens to environment", function() {
    const data = res.body;
    if (data.success && data.data.tokens) {
      bru.setEnvVar('host_access_token', data.data.tokens.accessToken);
      bru.setEnvVar('host_refresh_token', data.data.tokens.refreshToken);
      bru.setEnvVar('host_id', data.data.user.id);
    }
  });

  test("should have bank information", function() {
    const data = res.body;
    expect(data.data.user.bankName).to.equal('Bank Mandiri');
    expect(data.data.user.accountNumber).to.equal('1234567890');
  });
}

docs {
  # Register New Host

  Register a new host account with bank information for payouts.

  ## Request Body
  - `email` (string, required): Valid email address
  - `password` (string, required): Min 8 characters, must contain letter and number
  - `name` (string, optional): User's full name
  - `phone` (string, required): Phone number (10-15 digits)
  - `role` (string, required): Must be "HOST"
  - `bankName` (string, optional): Bank name for payout
  - `bankCode` (string, optional): Bank code
  - `accountNumber` (string, optional): Bank account number
  - `accountName` (string, optional): Account holder name

  ## Response
  Returns user object with bank information and JWT tokens.
}
