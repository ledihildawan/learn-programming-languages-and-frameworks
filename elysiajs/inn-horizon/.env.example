# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/inn_horizon?schema=public"

# Midtrans Payment Gateway Configuration
# Get your credentials from: https://dashboard.midtrans.com/
MIDTRANS_SERVER_KEY=your_server_key_here
MIDTRANS_CLIENT_KEY=your_client_key_here

# For Sandbox (Testing):
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxx

# For Production:
# MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxx
# MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxx

# Application Configuration
NODE_ENV=development  # development | production
APP_URL=http://localhost:3000
PORT=3000

# JWT Configuration (if used)
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# CORS Configuration (optional)
# ALLOWED_ORIGINS=http://localhost:3001,https://yourdomain.com

# Webhook Configuration
# Make sure this URL is accessible from internet for Midtrans webhooks
# For local development, use ngrok: https://ngrok.com/
# Example: WEBHOOK_URL=https://abcd1234.ngrok.io/api/webhooks/midtrans

# Email Configuration (optional, for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# File Upload Configuration (optional)
# MAX_FILE_SIZE=5242880  # 5MB in bytes
# UPLOAD_DIR=./uploads

# Rate Limiting (optional)
# RATE_LIMIT_WINDOW=15  # minutes
# RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration (optional)
# LOG_LEVEL=info  # debug | info | warn | error
# LOG_FILE=./logs/app.log
